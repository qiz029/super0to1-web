{
  "name": "super0to1-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cms:dev": "vite --config cms/vite.config.ts",
    "cms:build": "tsc -p tsconfig.cms.json && vite build --config cms/vite.config.ts",
    "cms:api": "wrangler dev --config cms/wrangler.dev.jsonc --ip 127.0.0.1 --port 8788",
    "cms:deploy": "npm run cms:build && wrangler deploy --config cms/wrangler.jsonc",
    "content:check": "tsx scripts/check-content.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.151.0"
  }
}
